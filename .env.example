# ===== 环境变量说明 =====
# 复制此文件为 .env（本地开发用），不要提交 .env 到 Git

# Vercel Postgres 自动注入 POSTGRES_URL；阿里云 Supabase/AnalyticDB PostgreSQL、Railway、本地开发用 DATABASE_URL
# 二者只需设置一个，代码优先读取 POSTGRES_URL
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/magazine_studio

# 文件存储：Vercel 默认走 Blob；阿里云迁移时设置为 oss
STORAGE_PROVIDER=oss
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=your-oss-bucket
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
# 可选：自定义域名/CDN 域名；不填则使用 OSS SDK 返回的公开 URL
OSS_PUBLIC_BASE_URL=https://your-bucket.oss-cn-shanghai.aliyuncs.com
OSS_UPLOAD_PREFIX=about-open-call

# 管理后台密码（自定义，不要使用弱密码）
ADMIN_PASSWORD=your_admin_password_here
JWT_SECRET=replace_with_a_long_random_secret
# 私有 OSS 文件临时下载链接签名密钥，建议与 JWT_SECRET 不同
FILE_ACCESS_SECRET=replace_with_another_long_random_secret

# Resend 邮件服务（https://resend.com）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# 发件人地址，需在 Resend 后台验证域名后才能自定义；未配置则使用默认值
RESEND_FROM=about编辑部 <noreply@yourdomain.com>

# 运行环境：development 或 production
# Railway 会自动设为 production
NODE_ENV=development

# 服务端口，Railway 会自动注入
PORT=3000
