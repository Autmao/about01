# ===== 环境变量说明 =====
# 复制此文件为 .env（本地开发用），不要提交 .env 到 Git

# 阿里云 Supabase/AnalyticDB PostgreSQL、本地开发用 DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/magazine_studio

# 文件存储：阿里云 OSS
STORAGE_PROVIDER=oss
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=your-oss-bucket
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_UPLOAD_PREFIX=about-open-call

# 管理后台密码（自定义，不要使用弱密码）
ADMIN_PASSWORD=your_admin_password_here
JWT_SECRET=replace_with_a_long_random_secret
# 私有 OSS 文件临时下载链接签名密钥，建议与 JWT_SECRET 不同
FILE_ACCESS_SECRET=replace_with_another_long_random_secret

# Resend 邮件服务（https://resend.com）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# 发件人地址，需在 Resend 后台验证域名后才能正式对外发送
# 未验证域名时可临时用 about编辑部 <onboarding@resend.dev> 发给 Resend 账号邮箱做测试
RESEND_FROM=about编辑部 <noreply@yourdomain.com>
# 仅本地开发调试用：true 时不发邮件，只在控制台打印验证码；生产环境保持 false 或不要配置
MAILER_CONSOLE_FALLBACK=false

# DeepSeek AI 聊天
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 运行环境：development 或 production
NODE_ENV=development

# 服务端口
PORT=3000
